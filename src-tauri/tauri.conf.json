{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-desktop-template",
  "version": "0.5.0",
  "identifier": "io.github.alfredclark.tauri-desktop-template",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri Desktop Template",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' http://localhost:1420",
        "font-src": "'self'",
        "object-src": "'none'"
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm", "dmg", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQjk1RjM3MTJFN0JDNTYKUldSV3ZPY1NOMSs1N04wdjh3aFVGbGVVakw5RCtiZ3VDS1hNK2thK0dkUXRFTUpYam1LS2JuRGUK",
      "endpoints": ["https://github.com/alfredclark/tauri-desktop-template/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
